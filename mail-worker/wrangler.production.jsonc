{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lc7c-cloud-mail",
  "account_id": "308d5352fbc7fcd678e243db735d5595",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mymail.lc7c.com",
      "zone_id": "4a3a54a11971f4f3b00b1440556b1603",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "lc7c-cloud-mail-db",
      "database_id": "03c56f6d-2d40-4192-8b9e-b03eda893e9b"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "kv",
      "id": "99628179a0eb49ebb855b9ad957e526d"
    }
  ],
  "assets": {
    "binding": "assets",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "domain": ["lc7c.com", "lc7c.me", "lc7c.dpdns.org", "swnb.dpdns.org"],
    "admin": "admin@lc7c.com",
    "orm_log": false,
    "analysis_cache": false
  }
}
